# SQLite local (Prisma). Ruta relativa a prisma/.
DATABASE_URL="file:./dev.db"

# DevExpert Inference (IA). Opcional: sin clave, las funciones de IA degradan
# con un mensaje claro. No commitear la clave real.
DEVEXPERT_API_KEY=

# Proveedor y modelos de IA (gateway OpenAI-compatible). Por defecto apuntan a
# DevExpert Inference; descomenta y ajusta para usar otro gateway compatible.
# AI_PROVIDER_BASE_URL="https://inference.devexpert.io/v1"
# AI_CHAT_MODEL="chat"
# AI_CHAT_PRO_MODEL="chat-pro"
# AI_IMAGE_EDIT_MODEL="image-edit"
