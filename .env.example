# SQLite local (Prisma). Ruta relativa a prisma/.
DATABASE_URL="file:./dev.db"

# DevExpert Inference (IA). Opcional: sin clave, las funciones de IA degradan
# con un mensaje claro. No commitear la clave real.
DEVEXPERT_API_KEY=

# Proveedor/modelo de IA (OpenAI-compatible). Todo es opcional; si no se
# define, se aplican los defaults documentados en src/lib/ai/config.ts.
# AI_BASE_URL="https://inference.devexpert.io/v1"
# AI_CHAT_MODEL="chat"
# AI_IMAGE_EDIT_MODEL="image-edit"
# AI_EMBEDDING_MODEL="embedding"
